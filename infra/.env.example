# Configuracion de PostgreSQL local para Docker Compose (UrLeads)
# Copia este archivo como infra/.env y define una contrasena segura para tu entorno local.
#
# Docker Compose lee este archivo automaticamente si ejecutas `docker compose` desde la carpeta infra/.
# Spring Boot NO lee este archivo de forma automatica; consulta infra/README.md para exportar
# las variables correspondientes en la terminal de arranque del backend.

POSTGRES_DB=urleads
POSTGRES_USER=urleads_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
